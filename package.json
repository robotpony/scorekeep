{
  "name": "scorekeep",
  "version": "0.9.0",
  "description": "A score-tracking tool for card and dice games.",
  "type": "module",
  "bin": {
    "scorekeep": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "generate": "tsx scripts/generate-definitions.ts",
    "dev:web": "npm run generate && vite",
    "build:web": "npm run generate && vite build",
    "preview:web": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "scorekeeping",
    "dice",
    "cards",
    "games",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.3.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "smol-toml": "^1.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.8.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
